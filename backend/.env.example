# Local SQLite database URL (overrides the default backend/pramaan.db)
DATABASE_URL=sqlite:///pramaan.db

# Optional: enables POST /incident/{id}/analyze (grounded Gemini analysis).
# Leave unset to run the backend without any AI capability: the evidence and
# audit endpoints keep working and /analyze returns HTTP 503.
# Never commit a real key.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Finite Gemini request timeout in MILLISECONDS (google-genai HttpOptions).
GEMINI_TIMEOUT_MS=30000

# Seconds without a heartbeat before a node is flagged EARLY_WARNING/DEGRADED.
HEARTBEAT_STALE_SECONDS=45

# DEMO_MODE gates DESTRUCTIVE demo-only operations: node failure injection,
# node recovery simulation, ledger tamper injection and POST /demo/reset.
# Defaults to OFF, so a non-demo deployment cannot inject faults or wipe data.
# Read-only monitoring (/demo/overview, /demo/nodes/{id}/health, /incidents,
# /audit/verify) is NOT gated. There is no authentication: keep this backend on
# a local/trusted network only.
DEMO_MODE=true

# Comma-separated browser origins allowed to call the API (CORS).
# Defaults to http://localhost:3000 and http://localhost:5173 when unset.
# Do NOT use "*" together with credentials: credentials are force-disabled
# when a wildcard is configured.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
